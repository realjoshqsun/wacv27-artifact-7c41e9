{
  "treebench_evaluation_only": true,
  "treebench_source_training_config": "TreeBench_upsampling_4x_genus_ood.json",
  "treebench_16x_protocol": "same_4x_checkpoint_runtime_R16",
  "diffusion_config": {
    "T": 1000,
    "beta_0": 0.0001,
    "beta_T": 0.02
  },
  "pointnet_config": {
    "model_name": "pointnet",
    "in_fea_dim": 3,
    "partial_in_fea_dim": 0,
    "out_dim": 3,
    "include_t": true,
    "t_dim": 128,
    "model.use_xyz": true,
    "attach_position_to_input_feature": true,
    "include_abs_coordinate": true,
    "include_center_coordinate": true,
    "record_neighbor_stats": false,
    "bn_first": false,
    "bias": true,
    "res_connect": true,
    "map_type": "cross_attention",
    "condition_loss": true,
    "include_class_condition": true,
    "num_class": 256,
    "class_condition_dim": 128,
    "gamma": 0.5,
    "bn": true,
    "include_local_feature": true,
    "include_global_feature": true,
    "global_feature_remove_last_activation": false,
    "pnet_global_feature_architecture": "[[3, 128, 256], [512, 1024]]",
    "attention_setting": {
      "use_attention_module": true,
      "attention_bn": true,
      "transform_grouped_feat_out": true,
      "last_activation": true,
      "add_attention_to_FeatureMapper_module": true
    },
    "architecture": {
      "npoint": "[1024, 256, 64, 16]",
      "radius": "[0.1, 0.2, 0.4, 0.8]",
      "neighbor_definition": "radius",
      "nsample": "[32, 32, 32, 32]",
      "feature_dim": "[32, 64, 128, 256, 512]",
      "mlp_depth": 3,
      "decoder_feature_dim": "[128, 128, 256, 256, 512]",
      "include_grouper": false,
      "decoder_mlp_depth": 2,
      "use_knn_FP": true,
      "K": 8
    },
    "condition_net_architecture": {
      "npoint": "[1024, 256, 64, 16]",
      "radius": "[0.1, 0.2, 0.4, 0.8]",
      "neighbor_definition": "radius",
      "nsample": "[32, 32, 32, 32]",
      "feature_dim": "[32, 32, 64, 64, 128]",
      "mlp_depth": 3,
      "decoder_feature_dim": "[32, 32, 64, 64, 128]",
      "include_grouper": false,
      "decoder_mlp_depth": 2,
      "use_knn_FP": true,
      "K": 8
    },
    "feature_mapper_architecture": {
      "neighbor_definition": "radius",
      "encoder_feature_map_dim": "[32, 32, 64, 64]",
      "encoder_mlp_depth": 2,
      "encoder_radius": "[0.1, 0.2, 0.4, 0.8]",
      "encoder_nsample": "[32, 32, 32, 32]",
      "decoder_feature_map_dim": "[32, 32, 64, 64, 128]",
      "decoder_mlp_depth": 2,
      "decoder_radius": "[0.1, 0.2, 0.4, 0.8, 1.6]",
      "decoder_nsample": "[32, 32, 32, 32, 32]"
    }
  },
  "train_config": {
    "dataset": "TreeBench_upsampling_16x_genus_ood",
    "root_directory": "experiments/upsampling_16x_genus_ood",
    "output_directory": "logs/checkpoint",
    "tensorboard_directory": "logs/tensorboard",
    "epochs_per_ckpt": 1,
    "iters_per_logging": 50,
    "n_epochs": 10,
    "learning_rate": 0.0001,
    "max_iters": 1000,
    "min_learning_rate": 1e-06,
    "eval_step": 30
  },
  "dataset_config": {
    "dataset": "TreeBench10K_upsampling",
    "data_dir": "./data/TreeBench/upsampling",
    "npoints": 512,
    "R": 16,
    "CATEGORY_FILE_PATH": "./data/TreeBench/8-1-1_genus-OOD_N>=8192.json",
    "subset": "train",
    "novel_input": false,
    "novel_input_only": false,
    "scale": 1,
    "batch_size": 24,
    "num_workers": 8,
    "augmentation": {
      "pc_augm_scale": 1.2,
      "pc_augm_rot": true,
      "pc_rot_scale": 90,
      "pc_augm_mirror_prob": 0.5,
      "pc_augm_jitter": false,
      "translation_magnitude": 0.1,
      "noise_magnitude_for_generated_samples": 0
    },
    "eval_batch_size": 24
  },
  "gen_config": {
    "ckpt_path": "logs/checkpoint"
  }
}
